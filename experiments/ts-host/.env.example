# ── Buddy host configuration ────────────────────────────────────────────────
# Copy to `.env` in the repo root (or set these in your shell). Buddy reads this
# file automatically when the host starts. NEVER commit your real .env.

# Your OpenAI API key. This stays on the computer that runs the host.
# The phone never sees it — it only ever receives short-lived ephemeral tokens.
OPENAI_API_KEY=sk-...

# Optional: point Buddy at any OpenAI-compatible endpoint instead of api.openai.com
# (Azure OpenAI, a local llama.cpp/ollama proxy, LiteLLM, OpenRouter, ...)
# BUDDY_API_BASE=https://api.openai.com/v1

# Realtime speech-to-speech model used by the phone's voice session.
#   gpt-realtime-2.1      — best quality (default if your account has it)
#   gpt-realtime-2.1-mini — cheaper + faster
#   gpt-realtime          — GA snapshot
BUDDY_REALTIME_MODEL=gpt-realtime-2.1

# Text model used for the "local voice" fallback pipeline, screen reading and
# the simulated brain. Any chat-completions model works.
BUDDY_TEXT_MODEL=gpt-4o

# Vision model used to locate things on screen when pointing/clicking.
BUDDY_VISION_MODEL=gpt-4o

# Buddy's default voice (alloy, ash, ballad, coral, cedar, echo, marin, sage, shimmer, verse)
BUDDY_VOICE=marin

# Port the host listens on. The phone connects to http://<your-computer-ip>:PORT
BUDDY_PORT=7777

# Set to 1 to let Buddy control the mouse and keyboard. Off = he can only look,
# point and talk. You can flip this any time from the menu bar / settings.
BUDDY_ALLOW_COMPUTER_USE=1

# Set to 1 to require a tap-to-confirm before anything hard to undo (default on)
BUDDY_CONFIRM_RISKY_ACTIONS=1

# Run the host with no real screen control (great for trying things out).
# Auto-enabled when no display is detected.
BUDDY_SIMULATE=0
